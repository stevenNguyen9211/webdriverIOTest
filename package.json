{
  "name": "webdriverio-multi-platform-demo",
  "version": "1.0.0",
  "description": "WebDriverIO Multi-Platform Testing: Android Mobile + Web Browser",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:web",
    "test:android": "wdio run ./config/wdio.conf.ts",
    "test:web": "wdio run ./config/wdio.web.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "test:all": "npm run test:android && npm run test:ios && npm run test:web",
    "test:web-chrome": "wdio run ./config/wdio.web.conf.ts --spec test/web/**/*.spec.ts",
    "test:web-login": "wdio run ./config/wdio.web.conf.ts --spec test/web/login.spec.ts",
    "test:web-forms": "wdio run ./config/wdio.web.conf.ts --spec test/web/form-interactions.spec.ts",
    "test:web-navigation": "wdio run ./config/wdio.web.conf.ts --spec test/web/navigation.spec.ts",
    "test:web-ui": "wdio run ./config/wdio.web.conf.ts --spec test/web/ui-interactions.spec.ts",
    "test:ios-launch": "wdio run ./config/wdio.ios.conf.ts --spec test/ios/launchTest.spec.ts",
    "test:ios-basic": "wdio run ./config/wdio.ios.conf.ts --spec test/ios/basic-interactions.spec.ts",
    "test:ios-ui": "wdio run ./config/wdio.ios.conf.ts --spec test/ios/ui-elements.spec.ts",
    "report:open": "open html-reports/",
    "report:web": "open html-reports/web/web-report.html",
    "report:android": "open html-reports/android/android-report.html",
    "report:ios": "open html-reports/ios/ios-report.html",
    "report:ios-enhanced": "node scripts/generateEnhancedReport.js ios && open html-reports/ios/ios-report-enhanced.html",
    "report:android-enhanced": "node scripts/generateEnhancedReport.js android && open html-reports/android/android-report-enhanced.html",
    "report:web-enhanced": "node scripts/generateEnhancedReport.js web && open html-reports/web/web-report-enhanced.html",
    "report:generate-enhanced": "node scripts/generateEnhancedReport.js"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "android",
    "mobile",
    "web",
    "browser",
    "selenium",
    "testing",
    "automation",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.2",
    "@wdio/appium-service": "^9.19.2",
    "@wdio/cli": "^9.19.2",
    "@wdio/globals": "^9.17.0",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "@wdio/types": "^9.19.2",
    "appium": "^3.0.2",
    "appium-uiautomator2-driver": "^5.0.3",
    "appium-xcuitest-driver": "^10.1.2",
    "chai": "^6.0.1",
    "chromedriver": "^140.0.4",
    "edgedriver": "^6.1.2",
    "geckodriver": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "wdio-html-nice-reporter": "^8.1.7"
  }
}
